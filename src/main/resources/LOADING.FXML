<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="MariSoftware_Weather_Gui.WindowController"
           stylesheets="@styles.css"
           styleClass="app-root">

    <VBox fx:id="weatherBoxLoading" spacing="10" alignment="CENTER" styleClass="card">
        <Label fx:id="loadingLabel" text="" styleClass="loading" visible="false" />
    </VBox>

    <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh" styleClass="refresh-button"
            visible="false" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets top="8" right="10" bottom="10" left="10"/>
        </StackPane.margin>
    </Button>

    <Button fx:id="closeButton" text="X" onAction="#handleClose" styleClass="close-button"
            StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </StackPane.margin>
    </Button>

</StackPane>
