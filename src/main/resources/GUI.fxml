<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="MariSoftware_Weather_Gui.WindowController"
           style="-fx-background-color: linear-gradient(to bottom, #1e3c72, #2a5298); -fx-background-radius: 15; -fx-padding: 20;">

    <VBox fx:id="weatherBox" spacing="10" alignment="CENTER">
        <Label fx:id="cityLabel"
               style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" />

        <HBox spacing="10" alignment="CENTER">
            <StackPane fx:id="weatherIcon"/>
            <Label fx:id="conditionLabel"
                   style="-fx-text-fill: gold; -fx-font-size: 12px; -fx-font-weight: bold;" />
        </HBox>

        <Label fx:id="temperatureText"
               style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" />

        <Label fx:id="temperatureLabel"
               style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" />
    </VBox>
    <VBox fx:id="weatherBox" spacing="10" alignment="CENTER">
        <Label fx:id="cityLabel"
               style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" />

        <HBox spacing="10" alignment="CENTER">
            <StackPane fx:id="weatherIcon"/>
            <Label fx:id="conditionLabel"
                   style="-fx-text-fill: gold; -fx-font-size: 12px; -fx-font-weight: bold;" />
        </HBox>

        <Label fx:id="temperatureText"
               style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" />

        <Label fx:id="temperatureLabel"
               style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" />
    </VBox>
    <Label fx:id="errorLabel" text="" style="-fx-text-fill: red; -fx-font-size: 12px;" visible="false" />

</StackPane>